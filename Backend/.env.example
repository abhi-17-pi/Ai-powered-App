# ==========================================================
# SmartAi Environment Configuration
# ==========================================================

# 1. Groq API Key (RECOMMENDED - 100% Free, 500+ tokens/sec, near-instant responses)
# Get your free key instantly at: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google Gemini API Key (Free tier)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. Optional: OpenRouter API Key (Free tier models available)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 4. OpenAI API Key (required for image generation with GPT Image 2)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# 5. Optional: Tavily API Key for live web search (Free tier at https://tavily.com)
# Note: Free DuckDuckGo instant search fallback is active if omitted
TAVILY_API_KEY=

# Default Model Selection
# Groq options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# Gemini options: gemini-2.0-flash, gemini-1.5-flash
AI_MODEL=llama-3.3-70b-versatile
